{
  "data_provider": {
    "driver": "sqlite",
    "name": "/var/lib/sftpgo/sftpgo.db",
    "external_auth_hook": "",
    "external_auth_scope": 0,
    "create_default_admin": true
  },
  "httpd": {
    "bindings": [
      {
        "port": 8080,
        "address": "0.0.0.0",
        "enable_web_admin": true,
        "enable_rest_api": true,
        "enable_openapi_spec": true,
        "cors": {
          "allowed_origins": ["http://localhost:3000", "http://127.0.0.1:3000"],
          "allowed_methods": ["GET", "POST", "PUT", "DELETE", "HEAD", "OPTIONS"],
          "allowed_headers": ["Authorization", "Content-Type", "X-SFTPGO-API-KEY"],
          "exposed_headers": ["ETag", "Content-Disposition"],
          "allow_credentials": true,
          "max_age": 3600
        }
      }
    ],
    "token_validation": 1,
    "max_upload_file_size": 53687091200
  },
  "sftpd": {
    "bindings": [
      {
        "port": 2022,
        "address": "0.0.0.0"
      }
    ]
  },
  "common": {
    "defender": {
      "enabled": true,
      "ban_time": 30,
      "threshold": 10,
      "score_invalid": 2,
      "score_valid": 1
    },
    "actions": {
      "execute_on": ["upload", "pre-upload", "login"],
      "hook": ""
    },
    "upload_mode": 1
  }
}
