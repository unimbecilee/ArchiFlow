# Dockerfile pour exécuter les migrations Alembic
FROM python:3.11-slim

WORKDIR /app

# Installer PostgreSQL client pour psql
RUN apt-get update && apt-get install -y postgresql-client && rm -rf /var/lib/apt/lists/*

# Copier les fichiers de requirements
COPY requirements/base.txt requirements/base.txt

# Installer les dépendances Python
RUN pip install --no-cache-dir -r requirements/base.txt

# Copier les fichiers nécessaires pour les migrations
COPY alembic.ini .
COPY migrations/ migrations/
COPY AppFlask/ AppFlask/
COPY config.py .
COPY init-db.sh .

# Rendre le script exécutable
RUN chmod +x init-db.sh

# Le script sera exécuté au démarrage du conteneur
CMD ["./init-db.sh"]
