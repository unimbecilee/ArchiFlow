# Configuration Pydio Cells pour ArchiFlow
# Adapté depuis unidoc/cells

# Configuration de la base de données MySQL
DB_HOST=cells_db
DB_PORT=3306
DB_NAME=archiflow_cells
DB_USER=pydio
DB_PASSWORD=P@ssw0rd

# Configuration de l'utilisateur administrateur
FRONTEND_LOGIN=superadmin
FRONTEND_PASSWORD=superadmin

# Clé secrète système (minimum 16 caractères)
CELLS_SECRET=archiflow_secret_key_2024_secure

# Configuration MinIO/S3 pour le stockage des documents
# Utilise le MinIO partagé avec archiflow
DSTYPE=S3
DS_S3_CUSTOM=http://minio:9000?minio=true
DS_S3_API_KEY=minioadmin
DS_S3_API_SECRET=minioadmin123

# Buckets MinIO (les buckets seront créés automatiquement si nécessaire)
DS_S3_BUCKET_DEFAULT=archiflow-pydiods1
DS_S3_BUCKET_PERSONAL=archiflow-personal
DS_S3_BUCKET_CELLS=archiflow-cellsdata
DS_S3_BUCKET_BINARIES=archiflow-binaries
DS_S3_BUCKET_THUMBS=archiflow-thumbnails
DS_S3_BUCKET_VERSIONS=archiflow-versions

# URLs des services ArchiFlow
# URL de l'API d'archivage (backend Flask)
CELLS_ARCHIVE_API_BASE_URL=http://archiflow_backend:5000/api/v1/archives-requests

# URL du scanner ArchiFlow
CELLS_SCANNER_URL=http://archiflow_backend:5000/scanner

# URL de la console de supervision (frontend React)
CELLS_SUPERVISION_CONSOLE_URL=http://archiflow_frontend:3000/

# URL de redirection en cas d'expiration de session
CELLS_SESSION_EXPIRED_REDIRECT_URL=http://archiflow_frontend:3000/login

# URL du bouton personnalisé dans la sidebar (après Bookmarks)
CELLS_CUSTOM_SIDEBAR_BUTTON_URL=http://archiflow_frontend:3000/dashboard

# Configuration TLS (désactiver en développement)
CELLS_SITE_NO_TLS=1
CELLS_SITE_BIND=0.0.0.0:8080
CELLS_SITE_EXTERNAL=http://localhost:8080

# Authentification webhooks ArchiFlow
PYDIO_WEBHOOK_SECRET=archiflow_pydio_webhook_secret_2024
PYDIO_API_TOKEN=archiflow_pydio_api_token_2024

# Configuration Collabora (optionnel - à activer si nécessaire)
# COLLABORA_ADMIN_USER=admin
# COLLABORA_ADMIN_PASSWORD=admin
# CELLS_FRONTEND_PLUGIN_EDITOR_LIBREOFFICE_ENABLED=true
# CELLS_FRONTEND_PLUGIN_EDITOR_LIBREOFFICE_LIBREOFFICE_HOST=archiflow_collabora
# CELLS_FRONTEND_PLUGIN_EDITOR_LIBREOFFICE_LIBREOFFICE_PORT=9980
# CELLS_FRONTEND_PLUGIN_EDITOR_LIBREOFFICE_LIBREOFFICE_SSL=false
# CELLS_FRONTEND_PLUGIN_EDITOR_LIBREOFFICE_LIBREOFFICE_SSL_SKIP_VERIFY=true
