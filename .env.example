# =============================================================================
# ArchiFlow — copier vers .env (cp .env.example .env)
# Source unique pour docker compose (env_file) et le backend Go.
# Hôtes ci-dessous = noms de services Docker (postgres, minio, cells).
# Dev hors Docker (go run) : remplacer postgres → localhost, minio → localhost:9000,
#   PYDIO_CELLS_INTERNAL_URL → http://localhost:4001
# =============================================================================

# --- PostgreSQL (ArchiFlow) ---
DATABASE_URL=postgresql://archiflow:archiflow_secret@postgres:5432/archiflow?sslmode=disable
POSTGRES_DB=archiflow
POSTGRES_USER=archiflow
POSTGRES_PASSWORD=archiflow_secret

# --- API Go ---
SERVER_PORT=5000
ENVIRONMENT=development
JWT_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-in-production
# Access court (memoire SPA) ; refresh en cookie HttpOnly (7 j par defaut)
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7
# Sessions serveur : inactivite (refresh) + plafond appareils connectes
JWT_SESSION_IDLE_MINUTES=30
JWT_MAX_SESSIONS_PER_USER=10
# Cookie refresh : Secure auto en production ; SameSite=Lax|Strict|None
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_BURST=5
AUTH_RATE_LIMIT_EXPIRES_SECONDS=180
API_RATE_LIMIT_PER_MINUTE=60
PRESIGNED_URL_TTL_MINUTES=15
# production: set AUTH_ALLOW_PUBLIC_REGISTER=true only if self-signup wanted
AUTH_ALLOW_PUBLIC_REGISTER=true
# DEV ONLY: bypass Pydio API auth (never in production). Requires explicit opt-in:
# PYDIO_DEV_INSECURE=1

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_DOCUMENTS_BUCKET=archiflow-documents
MINIO_ARCHIVES_BUCKET=archives-requests
MINIO_SFTP_INBOX_BUCKET=archiflow-sftp-inbox
# Credentials MinIO scoped inbox (recommandé prod) — voir infra/sftpgo/provision-minio-sftp-user.sh
# MINIO_SFTP_ACCESS_KEY=sftpgo-inbox
# MINIO_SFTP_SECRET_KEY=change-me-strong-secret
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_USE_SSL=false
MINIO_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_FILE_GB=50
UPLOAD_INIT_RATE_LIMIT_PER_HOUR=200
UPLOAD_INIT_RATE_LIMIT_BURST=50
MAX_STORAGE_BYTES=...
MAX_CONCURRENT_UPLOADS=10
SFTP_MAX_FILE_GB=50

# --- SFTPGo MFT (profil Docker: sftp) ---
# docker compose --profile sftp up -d
SFTPGO_INTEGRATION_ENABLED=false
SFTPGO_INTERNAL_URL=http://sftpgo:8080
SFTPGO_ADMIN_USER=admin
SFTPGO_ADMIN_PASSWORD=Admin1234!
SFTPGO_WEBHOOK_SECRET=archiflow_sftpgo_webhook_secret_2024
# Canal SFTP (orthogonal aux roles UI): user/manager default sftp_enabled + mode=drop;
# admin/validator/archivist default off (opt-in via admin). Modes: none|drop|inbox|full.
# Service accounts M2M: drop (default) or full.
# Port SFTP exposé : localhost:2022 — admin UI : localhost:8082

# --- Comptes seed ArchiFlow (création auto + compte Cells associé) ---
SEED_ADMIN_EMAIL=admin@archiflow.local
SEED_ADMIN_PASSWORD=Admin1234!
SEED_MANAGER_EMAIL=manager@archiflow.local
SEED_MANAGER_PASSWORD=Manager1234!
SEED_VALIDATOR_EMAIL=validator@archiflow.local
SEED_VALIDATOR_PASSWORD=Validator1234!
SEED_ARCHIVIST_EMAIL=archivist@archiflow.local
SEED_ARCHIVIST_PASSWORD=Archivist1234!

# --- Pydio Cells ↔ ArchiFlow (pattern socle) ---
# false = désactive provision + SSO
PYDIO_INTEGRATION_ENABLED=true
# URL vue navigateur (bouton SSO)
PYDIO_CELLS_URL=http://localhost:4001
# URL API depuis le backend Docker (réseau interne)
PYDIO_CELLS_INTERNAL_URL=http://cells:8080
PYDIO_WEBDAV_URL=http://localhost:4001/dav
# Compte admin Cells (install pydio_cells — FRONTEND_LOGIN / FRONTEND_PASSWORD)
PYDIO_ADMIN_LOGIN=superadmin
PYDIO_ADMIN_PASSWORD=superadmin
# Webhooks / API v1 Pydio → ArchiFlow
PYDIO_API_TOKEN=archiflow_pydio_api_token_2024
PYDIO_WEBHOOK_SECRET=archiflow_pydio_webhook_secret_2024
# PYDIO_DEV_INSECURE=1
# URL API vue navigateur (plugin Cells → archivage MinIO) — pas l'URL Docker interne
CELLS_ARCHIVE_API_BASE_URL=http://localhost:5010
ARCHIFLOW_CORS_ORIGINS=http://localhost:4001

# --- OnlyOffice Document Server (Sprint H — profil Docker: office) ---
# docker compose --profile office up -d
ONLYOFFICE_ENABLED=false
ONLYOFFICE_URL=http://localhost:9980
ONLYOFFICE_JWT_SECRET=archiflow_onlyoffice_jwt_change_me
# URL vue par le navigateur (script api.js) — identique a ONLYOFFICE_URL en local
NEXT_PUBLIC_ONLYOFFICE_URL=http://localhost:9980
# URL API atteignable depuis le conteneur Document Server (download + callback)
ONLYOFFICE_INTERNAL_API_URL=http://backend:5000
OFFICE_FILE_TOKEN_SECRET=change-me-office-file-token-min-32-chars

# --- Frontend Next.js ---
FRONTEND_URL=http://localhost:3000
# Proxy Next /api/* (build Docker : http://backend:5000 ; dev local : http://localhost:5010)
INTERNAL_API_URL=http://backend:5000
# Optionnel navigateur hors proxy ; en app les appels passent par /api (relatif)
NEXT_PUBLIC_API_URL=http://localhost:5010
NEXT_PUBLIC_CELLS_URL=http://localhost:4001
NEXT_PUBLIC_AUTH_ALLOW_PUBLIC_REGISTER=true
# Notifications temps reel : ws (defaut) | sse (legacy poll)
NEXT_PUBLIC_REALTIME_MODE=ws
# Pub/sub multi-replicas (docker : redis://redis:6379/0)
REDIS_URL=redis://redis:6379/0
# Optionnel : WS direct vers l'API (recommande Docker si /api/ws via Next echoue)
# NEXT_PUBLIC_WS_URL=ws://localhost:5010

# --- Email (optionnel, lu par le backend via env_file) — SMTP_* ou MAIL_* (Brevo) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Laisser vide pour utiliser MAIL_DEFAULT_SENDER (expéditeur vérifié Brevo)
# SMTP_FROM=
SMTP_TLS=true
# Alias compatibles (ex. Brevo) :
# MAIL_SERVER=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=
# MAIL_USE_TLS=True

# =============================================================================
# pydio_cells/.env (service Cells — docker compose --profile cells)
# FRONTEND_LOGIN / FRONTEND_PASSWORD = superadmin (doit matcher PYDIO_ADMIN_*)
# DB_HOST=cells_db, CELLS_SITE_EXTERNAL=http://localhost:4001
# Voir pydio_cells/.env.dist pour la liste complète Cells/MinIO
# =============================================================================
